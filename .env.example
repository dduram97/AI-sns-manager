# Naver Blog Browser Automation (Playwright)
NAVER_ID=wosl9511
NAVER_PASSWORD=qwe123@@
# live = real Playwright · mock = log-only (no browser)
NAVER_ADAPTER_MODE=live
# Your Naver *blog* id (주소창 blog.naver.com/{이값}) — 로그인 ID(NAVER_ID)와 다를 수 있음
# 기존 이웃 BuddyList 동기화에 필수에 가깝습니다. 미설정 시 MyBlog 리다이렉트로 자동 감지 시도.
# NAVER_BLOG_ID=my_blog_id
# visit smoke target for npm run verify:naver (blog_id only — no like/comment execute)
# VERIFY_NAVER_BLOG_ID=
# Optional: like/comment plan target (검증만, 실행 안 함)
# VERIFY_NAVER_POST_URL=
# VERIFY_NAVER_LOG_NO=
# Like debug screenshot → .data/debug/sympathy/ (NAVER_LIKE_DEBUG=1)
# Headful (BROWSER_HEADLESS=false) also enables evidence mode automatically.
# NAVER_LIKE_DEBUG=1
# NAVER_LIKE_DEBUG_HOLD_MS=10000
# Screenshots: like_before.png / like_after.png / like_evidence.json
# npm run verify:naver:actions — dry-run default; add --execute to run Adapter
# VERIFY_NAVER_COMMENT_BODY=
# VERIFY_NAVER_MUTUAL_BODY=
# --- Browser session (Live Naver) ---
# Primary (Like/visit 권장): CDP → 이미 실행 중인 Chrome에 연결
# Chrome recent builds block remote debugging on the *default* profile path.
# Use a non-default --user-data-dir (copy of daily profile is OK).
#
# Prerequisites:
#   See docs/cdp-auto-start-mac.md (manual start + macOS login auto-start via launchd)
#   1) Quit Chrome completely
#   2) Start once (keep this process running):
#      ./scripts/start-cdp-chrome.sh
#      # or:
#      /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
#        --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 \
#        --user-data-dir="$HOME/chrome-cdp-profile" \
#        --no-first-run --no-default-browser-check
#   3) Open http://127.0.0.1:9222/json/version (JSON must load)
#   4) Confirm Naver login in that Chrome window
USE_CDP=true
CDP_URL=http://127.0.0.1:9222
#
# Fallback / debug only: launchPersistentContext + dedicated profile
# (Like often fails here — session differs from daily Chrome; keep for smoke/debug)
# USE_CDP=false
NAVER_BROWSER_PROFILE=.data/browser/naver-profile
# Legacy aliases (NAVER_BROWSER_PROFILE / ACTION_TIMEOUT preferred)
BROWSER_USER_DATA_DIR=.data/browser/naver-profile
BROWSER_COOKIE_PATH=.data/browser/naver-cookies.json
# false = visible browser (recommended for first login / CAPTCHA / CDP attach)
BROWSER_HEADLESS=false
# Manual login wait (ms) when CAPTCHA appears — npm run naver:login (non-CDP)
# NAVER_LOGIN_WAIT_MS=600000
# Per-action timeout (ms) — Live Adapter + BrowserSessionManager
ACTION_TIMEOUT=90000
BROWSER_ACTION_TIMEOUT_MS=90000
BROWSER_NAV_TIMEOUT_MS=45000
# Failed ActionJob retry ceiling (target_ref.retry_count)
RETRY_LIMIT=3
# Stuck running → failed when updated_at older than this (ms)
# Default: ACTION_TIMEOUT + 60000
# ACTION_STUCK_RUNNING_MS=150000
# Max low-risk failed jobs auto-retried per tick recovery
# ACTION_RECOVERY_RETRY_BATCH=5
# Same target+action repeat window (ms)
# ACTION_REPEAT_WINDOW_MS=21600000
# Optional JSONL execution log path
# ACTION_EXECUTION_LOG_PATH=.data/logs/action-execution.jsonl

# Adapter-local random delays (ms) — not Policy
# Optional per-action random delay overrides (ms). Defaults are tuned for speed.
# NAVER_DELAY_LIKE_MIN_MS=500
# NAVER_DELAY_LIKE_MAX_MS=1400
# NAVER_DELAY_COMMENT_MIN_MS=600
# NAVER_DELAY_COMMENT_MAX_MS=1800
# NAVER_DELAY_MUTUAL_REQUEST_MIN_MS=2000
# NAVER_DELAY_MUTUAL_REQUEST_MAX_MS=5000

# Approval Inbox batch queue: delay between sequential ActionJobs (ms)
# Used when UI does not pass a fixed interval.
# APPROVAL_BATCH_DELAY_MIN_MS=5000
# APPROVAL_BATCH_DELAY_MAX_MS=10000

# Sync: max posts per blog per tick
NAVER_SYNC_POST_LIMIT=5

# Comment draft AI (Phase 1 — draft text only; no Naver / Approval / DB)
# mock = local, no network · openai = Chat Completions
COMMENT_AI_PROVIDER=mock
# COMMENT_AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# COMMENT_AI_MODEL=gpt-4o-mini
# COMMENT_AI_TIMEOUT_MS=20000
# COMMENT_AI_MAX_CHARS=120
# Neighbor-feed comment drafts (dedicated; default gpt-4o-mini, ~18s timeout)
# NEIGHBOR_COMMENT_AI_MODEL=gpt-4o-mini
# NEIGHBOR_COMMENT_AI_TIMEOUT_MS=30000
# Neighbor collect AI (batch analyze) — speed-first classifier
# Do not reuse COMMENT_AI_MODEL here; set explicitly if needed.
NEIGHBOR_AI_MODEL=gpt-4o-mini
# NEIGHBOR_AI_MODEL=gpt-5.4-mini
# NEIGHBOR_AI_BATCH_TIMEOUT_MS=45000
# Test: npm run draft:comment -- --title "..." --content "..." --example "..."
# Fallback only (styleExamples tone, no API): npm run draft:comment -- --fallback-only --example "..."

# Discover (Policy: discover_keywords + weekly_goals.discover_*)
# Set keywords in policy_profile.discover_keywords
# NAVER_DISCOVER_MOCK=1  # mock mode sample candidate

# Naver Search API — 서로이웃 후보 수집 (블로그 검색). CDP는 신청 실행에만 사용.
# https://developers.naver.com/docs/serviceapi/search/blog/blog.md
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


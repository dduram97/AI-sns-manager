    "verify:loop:clean": "node --import tsx scripts/verify-cleanup.ts",
    "verify:naver": "node --import tsx scripts/verify-naver-live.ts",
    "verify:naver:plan": "node --import tsx scripts/verify-naver-live.ts -- --plan-only",
    "verify:naver:actions": "node --import tsx scripts/verify-naver-actions.ts",
    "draft:comment": "node --import tsx scripts/draft-comment.ts",
    "analyze:like-session": "node --import tsx scripts/analyze-like-session.ts",

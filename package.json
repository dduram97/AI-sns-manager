  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tick": "node --import tsx scripts/run-tick.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "verify:neighbor-feed-schedule": "node --import ./scripts/stub-server-only.mjs --import tsx scripts/verify-neighbor-feed-schedule.ts",

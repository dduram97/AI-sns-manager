    "dotenv": "^17.4.2",
    "lucide-react": "^1.26.0",
    "next": "^15.5.21",
    "openai": "^6.49.0",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
